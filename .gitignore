# Delphi IDE project files. The .dpr is the project; opening it makes the IDE
# generate a .dproj in its own version's format, which an older IDE (XE7) may
# refuse to open. Keeping them untracked is what lets any version open a clone.
*.dproj
*.dproj.local
*.groupproj
*.stat
*.tvsconfig

# Test artefacts
heap.log
wd.log

# The throwaway platform probe. Its measurements are recorded in
# docs/specs/2026-07-30-concurrent-pool-design.md; the program itself was
# deleted once they were.
probe/

# Boss
modules/
boss-lock.json

# Editors
.vscode/
.idea/

# Extensionless Unix demo binaries from the Quick start, and its CI logs
/demo/AsyncSink
/demo/Pipeline
/asyncsink.log
/pipeline.log
